# Quill & Hearth companion configuration. Copy to .env and fill in.

# Your Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Model used to write entries (and the character brief)
GEMINI_MODEL=gemini-2.5-flash

# WoW: Forever client folder (contains Interface/ and WTF/)
WOW_DIR=C:\Program Files (x86)\World of Warcraft\_classic_beta_

# Account folder name under WTF\Account. Leave empty to auto-detect when there is only one.
WOW_ACCOUNT=
